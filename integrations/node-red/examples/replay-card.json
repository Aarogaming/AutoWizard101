    "once": false,
    "repeat": "",
    "x": 150,
    "y": 220,
    "wires": [
      [
        "author"
      ]
    ]
  },
  {
    "id": "card-trigger-3",
    "type": "inject",
    "z": "reusable-card",
    "name": "Deal configured card",
    "props": [
      {
        "p": "topic",
        "vt": "str"
