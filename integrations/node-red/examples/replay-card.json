[
  {
    "id": "reusable-card",
    "type": "tab",
    "label": "Reusable Maelstrom card",
    "info": "Configure card back, preview front, save/load and deal. Execution is a separate manual owner step."
  },
  {
    "id": "card-trigger-0",
    "type": "inject",
    "z": "reusable-card",
    "name": "Preview front",
    "props": [
      {
        "p": "topic",
        "vt": "str"
      }
    ],
    "topic": "card/preview",
    "once": false,
    "repeat": "",
    "x": 150,
    "y": 100,
    "wires": [
      [
        "author"
      ]
    ]
  },
  {
    "id": "card-trigger-1",
    "type": "inject",
    "z": "reusable-card",
    "name": "Save new card",
