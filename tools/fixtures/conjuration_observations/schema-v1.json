{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conjuration observation fixtures v1",
  "$comment": "Documentation only. The bounded Python loader additionally checks monotonic time/revisions, board identity/geometry, conditional card identities, source containment/digests, and explicit receipts. Synthetic simulation is not live qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "clock_origin",
    "synthetic",
    "board_id",
    "group_size",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "clock_origin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "synthetic": {
      "type": "boolean"
    },
    "board_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "group_size": {
      "type": "integer",
      "minimum": 2,
      "maximum": 8
    },
    "notes": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "time_ms",
              "board",
              "source"
            ],
            "properties": {
              "kind": {
                "const": "observation"
              },
              "time_ms": {
                "type": "number",
                "minimum": 0
              },
              "board": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "board_id",
                  "revision",
                  "phase",
                  "cards"
                ],
                "properties": {
                  "board_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "phase": {
                    "enum": [
                      "preview",
                      "active",
                      "animation",
                      "result",
                      "unknown"
                    ]
                  },
                  "cards": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "slot",
                        "x",
                        "y",
                        "state"
                      ],
                      "properties": {
                        "slot": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "x": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 16384
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 16384
                        },
                        "state": {
                          "enum": [
                            "hidden",
                            "face_up",
                            "removed",
                            "unknown"
                          ]
                        },
                        "identity": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "maxLength": 128
                        }
                      }
                    }
                  }
                }
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "annotation_origin",
                  "image",
                  "sha256"
                ],
                "properties": {
                  "annotation_origin": {
                    "enum": [
                      "synthetic",
                      "manual",
                      "recognizer"
                    ]
                  },
                  "image": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "sha256": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {
                  "proposal_slot": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "outcome": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "time_ms",
              "proposal_id",
              "status"
            ],
            "properties": {
              "kind": {
                "const": "action_receipt"
              },
              "time_ms": {
                "type": "number",
                "minimum": 0
              },
              "proposal_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "status": {
                "enum": [
                  "dispatched",
                  "rejected",
                  "unknown"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "time_ms",
              "board_id",
              "group_size"
            ],
            "properties": {
              "kind": {
                "const": "reset"
              },
              "time_ms": {
                "type": "number",
                "minimum": 0
              },
              "board_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "group_size": {
                "type": "integer",
                "minimum": 2,
                "maximum": 8
              }
            }
          }
        ]
      }
    }
  }
}
